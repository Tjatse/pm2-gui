# Copy to .env and fill in values. Never commit .env.
#
# Generate a key in the dashboard: Settings → API → Generate API key
# Then paste it here for local agents / scripts.

# Required for machine API access (Authorization: Bearer <key> or X-API-Key)
PM2_GUI_API_KEY=

# Base URL of the running pm2-gui instance (no trailing slash)
PM2_GUI_API_BASE=http://172.16.0.200:8088

# Example:
#   curl -s -H "Authorization: Bearer $PM2_GUI_API_KEY" \
#     "$PM2_GUI_API_BASE/api/v1/processes"
